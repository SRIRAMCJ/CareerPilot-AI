# Copy to .env.production on the cloud VM. Keep this file private (chmod 600).
CAREERPILOT_DOMAIN=careerpilot.example.com
ACME_EMAIL=you@example.com

# Dashboard browser login (HTTP Basic Auth prompt).
DASHBOARD_USERNAME=careerpilot
DASHBOARD_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Remote MCP Authorization: Bearer <token>
CAREERPILOT_MCP_AUTH_TOKEN=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_TOKEN

# Optional integrations. Keep disabled until OAuth credentials are configured.
AI_PROVIDER=none
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=
GMAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GOOGLE_CALENDAR_ENABLED=false
