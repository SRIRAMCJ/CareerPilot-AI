# Copy to .env locally. Never commit the real .env file.
APP_ENV=development
APP_NAME=CareerPilot AI
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Local database; change the development password on your machine.
DATABASE_URL=postgresql+psycopg://careerpilot:change-me@localhost:5432/careerpilot

# AI is optional. The foundation works without an LLM.
AI_PROVIDER=none
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Integrations disabled by default.
GMAIL_ENABLED=false
GOOGLE_CALENDAR_ENABLED=false
BROWSER_AUTOMATION_ENABLED=false
APPLICATION_SUBMISSION_ENABLED=false

# Safe operational defaults.
MAX_APPLICATIONS_PER_DAY=5
MINIMUM_JOB_MATCH_SCORE=70
