# Copy to .env locally. Never commit real credentials or OAuth tokens.
APP_ENV=development
APP_NAME=CareerPilot AI
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Local database and files
# CAREERPILOT_DATABASE_PATH=C:/Users/YourName/AppData/Local/CareerPilot/careerpilot.db
# CAREERPILOT_RESUME_DIR=C:/Users/YourName/AppData/Local/CareerPilot/resumes
# CAREERPILOT_GENERATED_DIR=C:/Users/YourName/AppData/Local/CareerPilot/generated

AI_PROVIDER=none
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Gmail OAuth: create a Google Cloud OAuth client and configure the exact redirect URI.
GMAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://127.0.0.1:8000/api/v1/gmail/auth/callback
# GMAIL_TOKEN_PATH=C:/Users/YourName/AppData/Local/CareerPilot/gmail-token.json

# Browser-assisted application preparation; optional Playwright dependency.
BROWSER_AUTOMATION_ENABLED=false
APPLICATION_SUBMISSION_ENABLED=false
# BROWSER_PROFILE_DIR=C:/Users/YourName/AppData/Local/CareerPilot/browser-profile
GOOGLE_CALENDAR_ENABLED=false
