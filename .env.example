# Backend settings. Copy to .env locally; never commit the real .env file.
APP_ENV=development
APP_NAME=CareerPilot AI
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Local SQLite database. The default is ./data/careerpilot.db relative to backend working directory.
# CAREERPILOT_DATABASE_PATH=C:/Users/YourName/AppData/Local/CareerPilot/careerpilot.db

# AI is optional. The foundation works without an LLM.
AI_PROVIDER=none
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Integrations disabled by default.
GMAIL_ENABLED=false
GOOGLE_CALENDAR_ENABLED=false
BROWSER_AUTOMATION_ENABLED=false
APPLICATION_SUBMISSION_ENABLED=false

# Optional private local storage overrides.
# CAREERPILOT_RESUME_DIR=C:/Users/YourName/AppData/Local/CareerPilot/resumes
# CAREERPILOT_GENERATED_DIR=C:/Users/YourName/AppData/Local/CareerPilot/generated
